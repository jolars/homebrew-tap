class Badness < Formula
  desc "Language server, formatter, and linter for LaTeX"
  homepage "https://badness.dev"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/jolars/badness/releases/download/v__VERSION__/badness-aarch64-apple-darwin.tar.gz"
      sha256 "__SHA_MACOS_ARM__"
    end
    on_intel do
      url "https://github.com/jolars/badness/releases/download/v__VERSION__/badness-x86_64-apple-darwin.tar.gz"
      sha256 "__SHA_MACOS_X86__"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/jolars/badness/releases/download/v__VERSION__/badness-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "__SHA_LINUX_ARM__"
    end
    on_intel do
      url "https://github.com/jolars/badness/releases/download/v__VERSION__/badness-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "__SHA_LINUX_X86__"
    end
  end

  def install
    bin.install "badness"
    # Man pages and completions ship in the tarball from the first release built
    # with the bundling packages.yml; guard so the formula also installs cleanly
    # against older releases that carried only the binary.
    man1.install Dir["man/*.1"]
    bash_completion.install "completions/badness.bash" if File.exist?("completions/badness.bash")
    fish_completion.install "completions/badness.fish" if File.exist?("completions/badness.fish")
    zsh_completion.install "completions/_badness" if File.exist?("completions/_badness")
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/badness --version")
  end
end
