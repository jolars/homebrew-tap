class Diplodocus < Formula
  desc "Documentation websites for polyglot software projects"
  homepage "https://diplodocus.cc"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    on_arm do
      url "https://github.com/jolars/diplodocus/releases/download/v__VERSION__/diplodocus-aarch64-apple-darwin.tar.xz"
      sha256 "__SHA_MACOS_ARM__"
    end
    on_intel do
      url "https://github.com/jolars/diplodocus/releases/download/v__VERSION__/diplodocus-x86_64-apple-darwin.tar.xz"
      sha256 "__SHA_MACOS_X86__"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/jolars/diplodocus/releases/download/v__VERSION__/diplodocus-aarch64-unknown-linux-gnu.tar.xz"
      sha256 "__SHA_LINUX_ARM__"
    end
    on_intel do
      url "https://github.com/jolars/diplodocus/releases/download/v__VERSION__/diplodocus-x86_64-unknown-linux-gnu.tar.xz"
      sha256 "__SHA_LINUX_X86__"
    end
  end

  def install
    bin.install "diplodocus"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/diplodocus --version")
  end
end
